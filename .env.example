# Server
PORT=8080
HOST=
LOG_LEVEL=info

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cnmt?sslmode=disable

# Cloudflare R2 (payment proofs)
OBJECT_STORAGE_ACCOUNT_ID=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET_NAME=
OBJECT_STORAGE_PRESIGNED_URL_EXPIRATION=3600

# Auth
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL=86400
BOOTSTRAP_SECRET=change-me-to-a-long-random-bootstrap-secret
ARGON2_MEMORY_KB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2

# Notifications (email)
ADMIN_EMAIL=admin@example.com
EMAIL_FROM=CN Connect <noreply@example.com>
EMAIL_API_KEY=re_your_resend_api_key

# WhatsApp Cloud API (transfer assurance template)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=transfer_processing_update_
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_BUSINESS_ACCOUNT_ID=
FRONTEND_URL=https://www.cnmt.shop

WHATSAPP_THANKS_TEMPLATE_NAME=transfer_completed_thanks
TRANSFER_ASSURANCE_AGE_MINUTES=30
TRANSFER_ASSURANCE_INTERVAL_MINUTES=5
TRANSFER_ASSURANCE_BATCH=100
