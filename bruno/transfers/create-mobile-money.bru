meta {
  name: Create transfer (MOBILE_MONEY)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/transfers
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "source_country_id": {{sourceCountryId}},
    "destination_country_id": {{destCountryId}},
    "amount_sent": "100.00",
    "sender_phone": "+233241234567",
    "recipient": {
      "recipient_name": "Jane Doe",
      "recipient_phone": "+212612345678",
      "receiving_method": "MOBILE_MONEY",
      "receiving_network_id": "{{networkId}}"
    }
  }
}

docs {
POST /api/v1/transfers
}
