meta {
  name: Create payment proof upload URL
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/transfers/payment-proof/upload-url
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "reference": "{{transferReference}}",
    "content_type": "image/jpeg"
  }
}

script:post-response {
  if (res.body && res.body.key) {
    bru.setEnvVar("paymentProofKey", res.body.key);
  }
}

docs {
POST /api/v1/transfers/payment-proof/upload-url
}
