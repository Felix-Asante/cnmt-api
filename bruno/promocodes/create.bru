meta {
  name: Create promo code
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/admin/promocodes
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "code": "WELCOME10",
    "discount_percentage": "10",
    "start_date": "2026-01-01T00:00:00Z",
    "end_date": "2026-12-31T23:59:59Z",
    "max_uses": 1000,
    "max_uses_per_user": 1
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("promoCodeId", res.body.id);
    if (res.body.code) bru.setEnvVar("promoCode", res.body.code);
  }
}

docs {
POST /api/v1/admin/promocodes
}
