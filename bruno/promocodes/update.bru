meta {
  name: Update promo code
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/v1/admin/promocodes/{{promoCodeId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "discount_percentage": "15",
    "start_date": "2026-01-01T00:00:00Z",
    "end_date": "2026-12-31T23:59:59Z",
    "max_uses": 2000,
    "max_uses_per_user": 2
  }
}

docs {
PATCH /api/v1/admin/promocodes/{id}
}
