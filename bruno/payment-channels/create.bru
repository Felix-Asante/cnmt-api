meta {
  name: Create payment channel
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/admin/countries/{{countryId}}/payment-channels
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "CIH Bank",
    "channel_type": "BANK",
    "extra_fee": "0"
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setEnvVar("paymentChannelId", res.body.id);
  }
}

docs {
POST /api/v1/admin/countries/{id}/payment-channels
}
